    {
        "id": "ee130990331b6b35",
        "type": "function",
        "z": "3a8922d1641384bf",
        "name": "desconnection_time",
        "func": "if (msg.payload === null) {\n    msg.payload = \"\";\n    return msg;\n}\nconst seconds = msg.payload.no_sensor_data_seconds;\nif (seconds === undefined || isNaN(seconds) || seconds <= 30) return null;\nif (seconds < 60) {\n    msg.payload = `${seconds} seconds`;\n} else {\n    msg.payload = `${(seconds / 60).toFixed(2)} minutes`;\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
